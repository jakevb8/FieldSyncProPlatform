{
  "name": "fieldsyncpro-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:push": "turbo run db:push --filter=@repo/api",
    "db:migrate": "turbo run db:migrate --filter=@repo/api",
    "db:studio": "turbo run db:studio --filter=@repo/api"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
